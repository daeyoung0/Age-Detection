# backend_server.py 환경변수 예시
# 실제 사용 시 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 커밋되지 않습니다)

# CORS 허용 origin. 콤마로 구분. 기본값 "*" (전체 허용 — 데모용)
# 운영 시 예: ALLOWED_ORIGINS=http://localhost:3000,https://my-pos.example.com
ALLOWED_ORIGINS=*

# SQLite DB 파일 경로. 미지정 시 %TEMP%/age-detection-main/store_data.db 사용
# AGE_DETECTION_DB_PATH=C:\Users\ohjun\Downloads\Age-Detection-demo\store_data.db
